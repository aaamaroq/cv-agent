# Local-only Compose configuration. Replace every value marked REPLACE before use.
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY

# These two values are also used to initialize the Langfuse project.
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE
LANGFUSE_SECRET_KEY=sk-lf-REPLACE
LANGFUSE_INIT_USER_EMAIL=local@example.invalid
LANGFUSE_INIT_USER_NAME=Local Admin
LANGFUSE_INIT_USER_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

# Generate random values with: openssl rand -hex 32
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
SALT=REPLACE_WITH_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
CLICKHOUSE_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REDIS_AUTH=REPLACE_WITH_RANDOM_SECRET
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_SECRET

CV_LANGFUSE_ENABLED=true
CV_MODEL=openai/gpt-oss-20b
CV_GUARDRAIL_MODEL=openai/gpt-oss-20b
CV_HISTORY_WINDOW=24
CV_LLM_TIMEOUT_S=60
