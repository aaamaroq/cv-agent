FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ ./src/
COPY docs/ ./docs/
COPY scripts/ ./scripts/
COPY profiles/ ./profiles/

EXPOSE 8000
CMD ["uvicorn", "cv_chat.server:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/src", "--reload-dir", "/app/docs", "--reload-dir", "/app/scripts", "--reload-dir", "/app/profiles", "--reload-include", "*.json"]
