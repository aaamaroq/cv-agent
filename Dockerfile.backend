FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY docs/ ./docs/

EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn cv_chat.server:app --host 0.0.0.0 --port ${PORT:-8080}"]
